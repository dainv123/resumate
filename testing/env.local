# Environment configuration based on user's .zshrc settings
# These values will be used by Cucumber tests and dashboard

# Application URLs
BASE_URL=http://localhost:5005
API_URL=http://localhost:5001

# Test execution settings
CI=false
HEADLESS=false
SLOW_MO=0
RECORD_VIDEO=false
PREWARM_BROWSER=true

# Logging and reporting
LOG_LEVEL=info
REPORT_FORMAT=html
