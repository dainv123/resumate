# Testing Framework Environment Configuration

# Base URL của ứng dụng cần test
BASE_URL=http://localhost:5006

# API URL (nếu khác base URL)
API_URL=http://localhost:4000

# Environment type: local, ci, staging, production
NODE_ENV=local

# Browser settings
HEADLESS=true
BROWSER_TYPE=chromium

# Test execution settings
SLOW_MO=0
RECORD_VIDEO=false
TAKE_SCREENSHOTS=true

# Test data settings
PREWARM_BROWSER=true
SETUP_TEST_DB=false
GENERATE_CLEANUP_REPORT=false

# CI/CD settings
CI=false

# Logging
LOG_LEVEL=info

# Report settings
REPORT_FORMAT=html
CLEANUP_TEMP_FILES=true
