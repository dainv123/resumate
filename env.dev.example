# Copy to .env.dev for Docker / npm (gitignored)
#   cp env.dev.example .env.dev
# Docker:
#   docker compose --env-file .env.dev -f docker-compose.dev.yml up -d

NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=resumate_dev
DB_NAME=resumate_dev
DB_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=true
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_SEC=3600
PORTFOLIO_CACHE_TTL_SEC=300

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=resumate-files

GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
AI_CV_PARSE_PROVIDER=openrouter
AI_INTERVIEW_PREP_PROVIDER=openrouter
AI_EMBEDDING_ENABLED=true
AI_EMBEDDING_PROVIDER=google
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768

JWT_SECRET=change-me-local-dev-secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

FRONTEND_PORT=5000
BACKEND_PORT=5001
PORT=5001
FRONTEND_URL=http://localhost:5000
BACKEND_URL=http://localhost:5001
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_APP_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=Resumate
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_INTERVIEW_PREP_ENABLED=true

EMAIL_USER=
EMAIL_PASSWORD=
MAIL_FROM_NAME=Resumate Support
AUTO_SEED=false
