# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=postgres

# Redis (AI rate limit + portfolio HTML cache; fail-open if unreachable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=true
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_SEC=3600
PORTFOLIO_CACHE_TTL_SEC=300

# AWS
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=resumate-files

# Google AI Studio
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GOOGLE_AI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
AI_CV_PARSE_PROVIDER=openrouter

# Interview Prep RAG (pgvector) — default Google free tier (768 dims)
AI_EMBEDDING_ENABLED=true
AI_EMBEDDING_PROVIDER=google
GOOGLE_EMBEDDING_MODEL=text-embedding-004
AI_EMBEDDING_DIMENSIONS=768
# Optional paid path (must match DB dims — use 768 model or change migration):
# AI_EMBEDDING_PROVIDER=openrouter
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# AI_EMBEDDING_DIMENSIONS=1536

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email (Optional - for notifications)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3002

# App
PORT=5000
NODE_ENV=development

# Auto Seed (Optional - automatically seed initial data on startup)
AUTO_SEED=false